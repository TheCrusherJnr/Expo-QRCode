# Copy to .env.local and fill in. Run `npm run vsco:setup` to list the IDs below.

STUDIO_NAME="Forever In Frame"
WEBSITE_URL=https://foreverinframe.com.au/
# Where the "View more of our work" buttons go
FILMS_URL=https://foreverinframe.com.au/
# Your deployed URL, used in QR codes, e.g. https://expo.foreverinframe.com.au
NEXT_PUBLIC_SITE_URL=

# --- VSCO Workspace (Táve) ---
# Create at https://workspace.vsco.co/settings/api with "Read and Write" access.
VSCO_API_KEY=
# Quote(s) whose options are shown as packages. Each sign-up gets a copy of the chosen option.
VSCO_TEMPLATE_QUOTE_IDS=
VSCO_BRAND_ID=
VSCO_JOB_TYPE_ID=
VSCO_LEAD_SOURCE_ID=
VSCO_LEAD_STATUS_ID=
# Adds a calendar event on the wedding date
VSCO_WEDDING_EVENT_TYPE_ID=
# Leave empty to use your default "Quote Invitation" email template.
VSCO_QUOTE_EMAIL_TEMPLATE_ID=

# true  = the app copies the chosen package into a quote and drafts the email.
# false = the app only creates the lead. A VSCO automation adds your quote template
#         (with contract and payment schedule) and drafts the email.
VSCO_CREATE_QUOTE=true

# draft = save the quote email as a draft in VSCO for you to review and send.
# send  = email it to the couple straight away.
QUOTE_EMAIL_MODE=draft

# Protects /qr?key=...
ADMIN_PASSWORD=

DEFAULT_PHONE_COUNTRY=AU
CURRENCY=AUD
SHOW_PRICES=true
